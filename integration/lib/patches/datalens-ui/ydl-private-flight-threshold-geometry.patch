+function isFlightThresholdSeriesName(name) {
+    const n = String(name || '')
+        .toLowerCase()
+        .replace(/\s+/g, ' ')
+        .trim();
+    return (
+        n === 'y' ||
+        /(^|\s)y(\s|$)/.test(n) ||
+        n.includes('пкз') ||
+        n.includes('load') ||
+        n.includes('%') ||
+        ((/(^|\s)60(\s|%|$)/.test(n) || /(^|\s)61(\s|%|$)/.test(n)) && n.includes('заг')) ||
+        (/(^|\s)80(\s|%|$)/.test(n) && n.includes('заг')) ||
+        (/(^|\s)100(\s|%|$)/.test(n) && n.includes('заг'))
+    );
+}
+
+function getFlightThresholdValueFromName(name) {
+    const n = String(name || '')
+        .toLowerCase()
+        .replace(/\s+/g, ' ')
+        .trim();
+    if (/(^|\s)100(\s|%|$)/.test(n)) {
+        return 100;
+    }
+    if (/(^|\s)80(\s|%|$)/.test(n)) {
+        return 80;
+    }
+    if (/(^|\s)61(\s|%|$)/.test(n)) {
+        return 61;
+    }
+    if (/(^|\s)60(\s|%|$)/.test(n)) {
+        return 60;
+    }
+    return null;
+}
