# ============================================================
# YDL OS - BI-Platform Environment Configuration
# ============================================================
# Скопируйте в .env и измените значения

# --- Общие ---
APP_ENV=prod
RELEASE_VERSION=2.9.0

# --- Порты ---
UI_PORT=8080

# --- PostgreSQL (метаданные) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=pg-user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB_US=pg-us-db
POSTGRES_DB_COMPENG=pg-compeng-db
POSTGRES_DB_AUTH=pg-auth-db
POSTGRES_DB_META_MANAGER=pg-meta-manager-db
POSTGRES_DB_TEMPORAL=pg-temporal-db
POSTGRES_DB_TEMPORAL_VISIBILITY=pg-temporal-visibility-db
POSTGRES_DB_DEMO=pg-demo-db

# --- Инициализация ---
INIT_DEMO_DATA=0
INIT_DB_DEMO=0
INIT_DB_AUTH=1
INIT_DB_META_MANAGER=1
INIT_DB_TEMPORAL=1

# --- Безопасность ---
CONTROL_API_CRYPTO_KEY=CHANGE_ME_BASE64_KEY
US_MASTER_TOKEN=CHANGE_ME_US_MASTER_TOKEN
AUTH_MASTER_TOKEN=CHANGE_ME_AUTH_MASTER_TOKEN

# --- Аутентификация ---
# Форк akrasnov87: US/meta-manager — RPC (us-auth), UI — страница входа.
US_AUTH_ENABLED=false
UI_AUTH_ENABLED=true
# Устаревшее: одна AUTH_ENABLED на все сервисы ломает US (JWT вместо RPC).
# AUTH_ENABLED=true
AUTH_SIGNUP_DISABLED=true
AUTH_KEY_MODE=false

# --- OIDC (IdP: Keycloak, Authentik, …) ---
OIDC=true
OIDC_ISSUER=https://idp.example.com/realms/your-realm
OIDC_BASE_URL=https://bi.example.com
OIDC_CLIENT_ID=datalens-client
OIDC_SECRET=CHANGE_ME_OIDC_CLIENT_SECRET
OIDC_NAME=SSO

# --- Таблицы ---
FLAT_TABLE_ROWS_LIMIT=100000
DATA_FETCHING_TIMEOUT_MS=120
DATA_SINGLE_FETCHING_TIMEOUT_MS=120

# --- Карты ---
YANDEX_MAP_ENABLED=0
YANDEX_MAP_TOKEN=

# --- Highcharts (переменные из upstream; в YDL-OS CDN Highcharts в UI отключён в коде, см. CHARTS_AND_LICENSES.md) ---
HC=0
HC_ENDPOINT=
HC_PROTOCOL=https

# --- Export ---
EXPORT_WORKBOOK_ENABLED=true
EXPORT_DASH_EXCEL=true

# --- IPv6 ---
IS_IPV6=false
YDL_FEATURES_ALL_BI=1
YDL_USE_OFFICIAL_ADMIN=1
ENABLE_LEGACY_PD_RBAC=0

# UI publish: 0 = official-only (no legacy-rbac in image). Prod default.
YDL_PUBLISH_LEGACY_RBAC=0
METRICS_ENABLED=1
CONNECTOR_AVAILABILITY_VISIBLE=clickhouse,postgres,chyt,ydb,mysql,greenplum,mssql,oracle,trino,appmetrica_api,metrika_api
