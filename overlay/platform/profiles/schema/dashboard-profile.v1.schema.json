{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ydl-os.local/schema/dashboard-profile.v1.json",
  "title": "YDL OS Dashboard Profile v1",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "ydl-os/v1"
    },
    "kind": {
      "const": "DashboardProfile"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "dashboardEntryId",
        "owner",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3
        },
        "dashboardEntryId": {
          "type": "string",
          "pattern": "^[0-9]{6,}$"
        },
        "workbookEntryId": {
          "type": "string",
          "pattern": "^[0-9]{6,}$"
        },
        "owner": {
          "type": "string",
          "minLength": 2
        },
        "version": {
          "type": "string",
          "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": [
        "params",
        "selectors",
        "permissions",
        "uiBehavior",
        "tests",
        "runtimePolicy"
      ],
      "properties": {
        "params": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "canonical",
              "type",
              "aliases",
              "defaultValue",
              "nullable"
            ],
            "properties": {
              "canonical": {
                "type": "string",
                "minLength": 2
              },
              "type": {
                "type": "string",
                "enum": [
                  "string",
                  "integer",
                  "date",
                  "datetime",
                  "interval",
                  "string[]"
                ]
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "defaultValue": {},
              "nullable": {
                "type": "boolean"
              },
              "normalizers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "trim",
                    "to_csv",
                    "interval_to_scalar_date",
                    "drop_text_for_integer_alias"
                  }
                }
              }
            },
            "additionalProperties": false
          }
        },
        "selectors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "param",
              "type",
              "dependsOn",
              "disabledUntil"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "param": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": [
                  "date",
                  "select",
                  "multiselect",
                  "input"
                ]
              },
              "dependsOn": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "disabledUntil": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "errorPolicy": {
                "type": "object",
                "properties": {
                  "retryStatuses": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "nonRetryableStatuses": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "maxRetries": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "permissions": {
          "type": "object",
          "required": [
            "reader",
            "editor",
            "admin"
          ],
          "properties": {
            "reader": {
              "$ref": "#/$defs/roleActions"
            },
            "editor": {
              "$ref": "#/$defs/roleActions"
            },
            "admin": {
              "$ref": "#/$defs/roleActions"
            }
          },
          "additionalProperties": false
        },
        "uiBehavior": {
          "type": "object",
          "required": [
            "topbar",
            "menu",
            "groupEditor"
          ],
          "properties": {
            "topbar": {
              "$ref": "#/$defs/uiToggleMap"
            },
            "menu": {
              "$ref": "#/$defs/uiToggleMap"
            },
            "groupEditor": {
              "type": "object",
              "required": [
                "enabled",
                "readerVisible"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "readerVisible": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "runtimePolicy": {
          "type": "object",
          "required": [
            "maxFilterLatencyMs",
            "maxRenderLatencyMs",
            "rollbackOnProfileFailure"
          ],
          "properties": {
            "maxFilterLatencyMs": {
              "type": "integer",
              "minimum": 100
            },
            "maxRenderLatencyMs": {
              "type": "integer",
              "minimum": 100
            },
            "rollbackOnProfileFailure": {
              "type": "boolean"
            },
            "canaryPercent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "tests": {
          "type": "object",
          "required": [
            "smoke",
            "criticalJourneys"
          ],
          "properties": {
            "smoke": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "criticalJourneys": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "roleActions": {
      "type": "object",
      "required": [
        "view",
        "changeFilters",
        "edit",
        "openGroupEditor",
        "share"
      ],
      "properties": {
        "view": {
          "type": "boolean"
        },
        "changeFilters": {
          "type": "boolean"
        },
        "edit": {
          "type": "boolean"
        },
        "openGroupEditor": {
          "type": "boolean"
        },
        "share": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "uiToggleMap": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    }
  },
  "additionalProperties": false
}
