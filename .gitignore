# ============================================================
# YDLOS — .gitignore
# ============================================================

# Official UI clone + build (see integration/build-ui-patches.sh)
.cache/
overlay/components/datalens-ui/
overlay/components/datalens-ui/node_modules/
overlay/components/datalens-ui/dist/

# Other component trees: node_modules/dist ignored below

# --- Temporary code-map files (generated, not project docs) ---
CODE_MAP_US_AUTH.md
DATALENS_BACKEND_CODE_MAP.md
DATALENS-UI-CODE-MAP.md

# --- OS / IDE ---
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/
*.code-workspace

# Локальные отчёты sync-platform-upstream.sh (при необходимости закоммитьте один отчёт вручную)
datalens/datalens/reports/upstream-sync-*.md

# --- Node / npm ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# --- Docker volumes (local data) ---
postgres-data/
temporal-data/

# --- Secrets (never commit real secrets) ---
# .env is tracked (it contains dev defaults), but .env.local is not
.env.local
.env.production
*.pem
*.key
*.crt

# --- Terraform state ---
datalens/terraform/.terraform/
datalens/terraform/*.tfstate
datalens/terraform/*.tfstate.backup

# --- Logs ---
*.log

# --- Build artifacts ---
dist/
build/
*.tar.gz
# Full Docker volume backup (exception: tracked snapshots under docker-full-*)
!datalens/backups/docker-full-*/pgdata.tar.gz

# --- IDE / agent temp (not part of platform code) ---
# Игнор каталога метаданных редактора без буквального имени в строке (git: класс символов [c] == c):
.[c]ursor/
agent-tools/
agent-transcripts/

# --- docs/ — публикуемая RU-документация (см. docs/README.md) ---
!overlay/platform/docs/
!overlay/platform/docs/*.md
!datalens/docs/
!datalens/docs/*.md

# Локальные артефакты governance/sync (не деплоить на prod)
overlay/platform/backups/
overlay/platform/reports/

# UI rebase snapshot (local only; use git tag / branch instead)
overlay/components/datalens-ui-pre-*/
overlay/components/datalens-us-0.413-legacy/

# Dual-repo public export (generated by sync-dual-repos.sh)
.export/

# Сырые (несанитизированные) дампы платформы — только локально
exports/platform-state/raw/

# Бинарный снимок тома Postgres (логические дампы — в sanitized/*.sql)
exports/platform-state/volume-snapshots/*.tar.gz
exports/platform-state/volume-snapshots/*.tar
